# Root-level safety net. Each subproject (frontend/parkPD, backend/park-pd-server)
# keeps its own .gitignore, which still applies to its own subtree.

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Dependencies
node_modules/

# Env / secrets — applies recursively, incl. backend/park-pd-server/.env
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

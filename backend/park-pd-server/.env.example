# Copy to .env and fill in. Nothing here is a real value.
#
# .env is gitignored, so this file is the only record of what the server needs.
# The ones marked REQUIRED are checked at boot and refuse to start without a
# real value - the rest have working defaults and fail quietly, which is why
# they are worth setting deliberately.

# --- Database ---
# REQUIRED.
# Railway > your Postgres service > Variables.
# From a laptop use DATABASE_PUBLIC_URL (the *.proxy.rlwy.net host) - the
# private one only resolves inside Railway's network.
# On the Railway backend service, set this as a variable reference instead, so
# rotating the password does not need a redeploy:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/railway

# --- Secrets ---
# All three REQUIRED, all three at least 32 characters, all three generated
# with: openssl rand -hex 32
# Use fresh values in production - never the ones from a laptop.
JWT_SECRET=
REFRESH_HASH_SECRET=
OTP_HASH_SECRET=

# --- App ---
# NODE_ENV=production turns on the production-only boot checks below.
NODE_ENV=development
# Browser origins allowed to call this API, comma-separated, no trailing slash.
# ONLY the react-native-web build needs this. The iOS and Android builds send no
# Origin header and are not subject to CORS at all, so a native-only deploy can
# leave this empty.
FRONTEND_ORIGIN=http://localhost:3000
# Railway sets PORT itself. Leave unset unless running locally.
PORT=8000

# --- JWT ---
# How long an access token lives. The client refreshes before it lapses.
JWT_EXPIRES_IN=15m
# How long a refresh token lives, in days.
JWT_REFRESH_EXPIRES_IN_DAYS=60

# --- OTP ---
# A fixed code, so sign-in works with no mail provider behind it. Anyone
# holding a challengeId can then sign in as anyone, so it is a local-only
# setting by default: under NODE_ENV=production the server refuses to boot on
# it unless the override below is also set.
OTP_DEV_CODE=
# The deliberate exception, for a test deploy with no real accounts on it and
# no SMTP account to send codes with. Read only when NODE_ENV=production and
# OTP_DEV_CODE is set, and the server logs a warning on every boot while both
# are on. Unset both before anyone real signs up.
ALLOW_DEV_OTP_IN_PRODUCTION=false
OTP_EXPIRY_MINUTES=5
# 4 digits is only 9000 possibilities, so this and the expiry are what keep a
# code out of guessing range. Do not loosen both.
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Mail (how codes reach an email address) ---
# false logs the code to the server instead of sending it. Fine locally, and
# the reason email sign-in silently stops working if it is left false in
# production.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
# 465 is implicit TLS, which is what the transport is configured for.
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=ParkPD <noreply@example.com>

# --- SMS (how codes reach a mobile number) ---
# No provider is wired up yet, so this stays false and production is
# email-only: a phone sign-in is refused with a message pointing at email.
# See the TODO in src/sms/sms.service.ts.
SMS_ENABLED=false

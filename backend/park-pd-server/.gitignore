# compiled output
/dist
/node_modules
/build

# Logs
# Anchored: a bare "logs" also matches src/logs/, which kept the whole logs
# module out of version control.
/logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files.
# The glob is the one that matters: these hold the database URL, the signing
# secrets and the SMTP password, so anything shaped like an env file stays out
# of git by default and .env.example is named back in explicitly.
.env
.env.*
!.env.example

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Local file-backed stores (accounts, OTP challenges, refresh tokens).
# Personal data - never commit.
data/

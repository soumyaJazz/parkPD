{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // DOM is needed for the web target (index.web.tsx, react-native-web).
    "lib": ["ESNext", "DOM"],
    // `parkpd/env` is swapped for one of src/api/env/*.ts by whichever bundler
    // is running (see env.config.cjs). All three files share a single type, so
    // pointing the compiler at any one of them typechecks the app correctly.
    "paths": {
      "parkpd/env": ["./src/api/env/local.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "dist"]
}
